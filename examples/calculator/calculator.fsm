# The calculator's grammar layer.
#
# The machine decides what sequence of tokens is legal, and which operator is pending — by
# BEING in the state that names it, not by remembering it in a register. The numbers are
# elsewhere (calculator.cpp): no row can hold one, because a `when` clause compares one int
# that rides on the event (SPEC.md section 3).
#
# The kinds are declared by name below — the name table is the file's own declarations.
# One kind carries a value: `number`, whose value is the operand, 0 .. 2147483647 (never
# negative: `-` is always the subtraction OPERATOR here, so `0 - 5` rather than `-5`).
# `equals` ends the line: print what is held. `clear` starts a new one.
#
# Enter (`Equals`) is deliberately absent from every `Pending*` state: `12 +` is not in this
# machine's language, so the shell says so instead of inventing a value.
version 1
machine Calculator
initial Entry

# The event kinds, by name. The numbers are what the rows below used to carry: a
# name is another spelling for the same number, so nothing else in the file changed.
kind number = 1
kind add = 2
kind sub = 3
kind mul = 4
kind div = 5
kind equals = 6
kind clear = 7

# The first operand of a line.
transition Entry --number--> Accum action take_operand
transition Entry --clear--> Entry action clear_all

# An operator does not need an action to record itself: the state it moves to IS the operator.
transition Accum --add--> PendingAdd
transition Accum --sub--> PendingSub
transition Accum --mul--> PendingMul
transition Accum --div--> PendingDiv
transition Accum --equals--> Accum
# No action on the Equals rows: the shell prints what the registers hold, and an action
# that does nothing is one that should not be named. The state stops where the line
# finished rather than returning to Entry — Clear does that, at the start of the next
# line — so the state a finished line leaves behind says how it ended.
transition Accum --clear--> Entry action clear_all

# A number with an operator waiting: the arithmetic runs in the action, which reads the
# operand from the event and the running value from the registers.
transition PendingAdd --number--> Accum action add_operand
transition PendingSub --number--> Accum action sub_operand
transition PendingMul --number--> Accum action mul_operand
transition PendingAdd --clear--> Entry action clear_all
transition PendingSub --clear--> Entry action clear_all
transition PendingMul --clear--> Entry action clear_all

# Division by zero is a ROW, not a register check: the divisor is this event's value and the
# pending operator is a state, so a guard can see what it needs. The generator emits the
# guarded row first, which is what makes `x / 0` reachable at all.
transition PendingDiv --number--> Error when eq 0 action note_division_by_zero
transition PendingDiv --number--> Accum action div_operand
transition PendingDiv --clear--> Entry action clear_all

# The error state is TOTAL over the rest of the line on purpose: if a token were refused here
# instead, the shell would report "unexpected operator" and hide the division that caused it.
transition Error --number--> Error
transition Error --add--> Error
transition Error --sub--> Error
transition Error --mul--> Error
transition Error --div--> Error
transition Error --equals--> Error
transition Error --clear--> Entry action clear_all